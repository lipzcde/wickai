{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "LLM_BASE_URL": "@llm_base_url",
    "LLM_API_KEY": "@llm_api_key",
    "LLM_DEFAULT_MODEL": "kirocor",
    "JWT_SECRET": "@jwt_secret"
  }
}
